{
  "name": "n8n-nodes-gritz",
  "version": "0.1.8",
  "description": "n8n community node for gritz task orchestration",
  "keywords": ["n8n-community-node-package"],
  "license": "MIT",
  "main": "dist/nodes/Gritz/Gritz.node.js",
  "scripts": {
    "generate": "buf generate",
    "build": "tsc && cp nodes/Gritz/gritz.png dist/nodes/Gritz/gritz.png",
    "lint": "eslint . --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/GritzApi.credentials.js"],
    "nodes": ["dist/nodes/Gritz/Gritz.node.js"]
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.10.2",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-web": "^2.1.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.63.0",
    "@bufbuild/protoc-gen-es": "^2.10.2",
    "@types/node": "^24.0.0",
    "n8n-workflow": "*",
    "typescript": "^6.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
